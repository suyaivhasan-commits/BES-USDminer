<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0,
                 maximum-scale=1.0, user-scalable=no">

  <title>BES Miner</title>

  <!-- Telegram Mini App -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0b1020;
      color: white;
      text-align: center;
    }

    .app {
      max-width: 500px;
      margin: auto;
      padding: 25px 18px;
    }

    .logo {
      font-size: 42px;
      margin-top: 15px;
    }

    h1 {
      margin: 8px 0;
      font-size: 30px;
    }

    .subtitle {
      color: #9ca3af;
      margin-bottom: 25px;
    }

    .balance-card {
      background: linear-gradient(135deg, #172554, #1e3a8a);
      border-radius: 20px;
      padding: 25px;
      margin-bottom: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .balance-title {
      color: #bfdbfe;
      font-size: 15px;
    }

    .balance {
      font-size: 38px;
      font-weight: bold;
      margin-top: 8px;
    }

    .status {
      margin-top: 10px;
      font-size: 14px;
      color: #cbd5e1;
    }

    .mine-button {
      width: 100%;
      border: none;
      border-radius: 16px;
      padding: 18px;
      font-size: 19px;
      font-weight: bold;
      color: white;
      background: #2563eb;
      cursor: pointer;
      margin-top: 10px;
    }

    .mine-button:active {
      transform: scale(0.98);
    }

    .mine-button.active {
      background: #16a34a;
    }

    .info {
      margin-top: 20px;
      background: #111827;
      border-radius: 16px;
      padding: 18px;
      text-align: left;
    }

    .info p {
      margin: 9px 0;
      color: #d1d5db;
    }

    .user {
      margin-top: 20px;
      color: #94a3b8;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <div class="app">

    <div class="logo">⛏️</div>

    <h1>BES Miner</h1>

    <div class="subtitle">
      Telegram Mini App
    </div>

    <div class="balance-card">

      <div class="balance-title">
        Current Balance
      </div>

      <div class="balance">
        $<span id="balance">0.00</span>
      </div>

      <div class="status" id="status">
        Mining is currently OFF
      </div>

    </div>

    <button
      class="mine-button"
      id="mineButton"
      onclick="startMining()">
      🚀 START MINING
    </button>

    <div class="info">

      <p>⚡ Mining Rate: <b>$0.01 / minute</b></p>

      <p>⏱️ Status:
        <b id="statusText">Inactive</b>
      </p>

    </div>

    <div class="user">
      Telegram Mini App
    </div>

  </div>


  <script>

    // Telegram WebApp
    const tg = window.Telegram.WebApp;

    tg.ready();
    tg.expand();


    // Balance
    let balance = parseFloat(
      localStorage.getItem("bes_balance") || "0"
    );

    let mining = localStorage.getItem("bes_mining") === "true";


    // Elements
    const balanceElement =
      document.getElementById("balance");

    const statusElement =
      document.getElementById("status");

    const statusText =
      document.getElementById("statusText");

    const mineButton =
      document.getElementById("mineButton");


    // Display balance
    function updateBalance() {

      balanceElement.innerText =
        balance.toFixed(2);

    }


    // Update mining UI
    function updateMiningUI() {

      if (mining) {

        statusElement.innerText =
          "Mining is currently ACTIVE";

        statusText.innerText =
          "Active";

        mineButton.innerText =
          "⛏️ MINING ACTIVE";

        mineButton.classList.add("active");

      } else {

        statusElement.innerText =
          "Mining is currently OFF";

        statusText.innerText =
          "Inactive";

        mineButton.innerText =
          "🚀 START MINING";

        mineButton.classList.remove("active");

      }

    }


    // Start mining
    function startMining() {

      if (mining) {
        return;
      }

      mining = true;

      localStorage.setItem(
        "bes_mining",
        "true"
      );

      updateMiningUI();

    }


    // Mining reward
    setInterval(function() {

      if (mining) {

        balance += 0.01;

        localStorage.setItem(
          "bes_balance",
          balance.toFixed(2)
        );

        updateBalance();

      }

    }, 60000);


    // Initial display
    updateBalance();
    updateMiningUI();

  </script>

</body>
</html>
